# XCP-ng Server Configuration
# Copy this file to .env and fill in your actual values
# The .env file should NOT be committed to git

# XCP-ng server connection details
XCP_HOST=192.168.1.198
XCP_USERNAME=root
XCP_PASSWORD=your_xcp_password_here

# XCP-ng VM template and configuration  
XCP_TEMPLATE=your_template_name
VM_USERNAME=root
VM_PASSWORD=your_vm_password

# Optional: SSH key file for VM access
# VM_KEY_FILE=/path/to/your/ssh/key

# Environment settings
PYLUA_DEBUG=true
